# Never commit the real Discord bot token.
DISCORD_TOKEN=

# Optional. If blank, the bot will locate the guild named OTR.
DISCORD_GUILD_ID=
OTR_GUILD_NAME=OTR

# Idempotent: safe to leave enabled; existing channels are reused.
ENABLE_SERVER_SETUP=true

# News: every 15 minutes; BLS/BEA calendar: checked every 5 minutes.
# Enabled unless explicitly set to false.
ENABLE_TRADING_INTELLIGENCE=true
